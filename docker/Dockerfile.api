FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /workspace

COPY shared-contracts /workspace/shared-contracts
COPY api-service /workspace/api-service

WORKDIR /workspace/api-service
RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/workspace/api-service
EXPOSE 8000

# API_PORT is read at runtime from the environment (default 8000 in Settings).
CMD ["sh", "-c", "uv run uvicorn app.main:app --host 0.0.0.0 --port ${API_PORT:-8000}"]
