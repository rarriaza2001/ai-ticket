# Template for docker/.env (safe to commit — no real secrets).
# Setup:  cp .env.example .env   then edit .env (gitignored) and add OPENAI_API_KEY if needed.

POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_DB=tickets
# Host port on your machine (container Postgres stays on 5432)
POSTGRES_PORT=5433

DATABASE_URL=postgresql://ticket:ticket@postgres:5432/tickets
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
ENV=local
SERVICE_NAME=api-service
API_PORT=8000

# Optional api-service pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ai-worker AI — default mock; switch to openai and set OPENAI_API_KEY in .env only
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini
OPENAI_SUGGESTION_MODEL=gpt-4.1-mini
RETRIEVAL_TOP_K=5
RETRIEVAL_USABLE_MAX_DISTANCE=0.30
RETRIEVAL_CONTEXT_MAX_AGE_DAYS=180
