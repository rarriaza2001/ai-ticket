FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /workspace

COPY shared-contracts /workspace/shared-contracts
COPY ai-worker /workspace/ai-worker

WORKDIR /workspace/ai-worker
RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/workspace/ai-worker

CMD ["uv", "run", "python", "-m", "worker.main"]
