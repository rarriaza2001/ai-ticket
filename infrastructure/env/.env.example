# Host-oriented example (localhost targets). In Compose, use docker/.env.example instead.

POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_DB=tickets

# SQLAlchemy async (postgresql:// is normalized to postgresql+asyncpg:// in app code)
# Published host port from docker compose (POSTGRES_PORT, default 5433)
DATABASE_URL=postgresql://ticket:ticket@localhost:5433/tickets

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
ENV=local
SERVICE_NAME=api-service

API_PORT=8000
