# Copy to docker/.env or repo root .env and adjust for local Compose.

# Postgres (Compose defaults)
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_DB=tickets

# Async connection string for api-service / ai-worker (asyncpg)
DATABASE_URL=postgresql://ticket:ticket@localhost:5432/tickets

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
ENV=local

# Placeholder for Phase 2 queue implementation (e.g. sqs, redis_stream)
QUEUE_BACKEND=unset

API_PORT=8000

# Reserved for Phase 2 (do not set secrets in committed files)
# OPENAI_API_KEY=
